# Descargas voluminosas de fuentes externas (CDAU, OSM, CartoCiudad)
data/fuentes/*
!data/fuentes/.gitkeep

# Justificantes y acuses originales: contienen NIE, domicilio y teléfono.
# NUNCA se suben — este repositorio es público.
data/registro/*
!data/registro/.gitkeep

# Caché de geocodificación generada automáticamente
data/cache/*
!data/cache/.gitkeep

# Salidas intermedias del ETL
data/tmp/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# QGIS
*.qgs~
*.qgz~

# Sistema
.DS_Store
